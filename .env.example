# Copia este archivo a .env y completa los valores. .env NUNCA va al repo.

# --- PostgreSQL ---
# Usa una contraseña alfanumérica (va dentro de DATABASE_URL). Ej: openssl rand -hex 24
POSTGRES_USER=justipe
POSTGRES_PASSWORD=
POSTGRES_DB=justipe

# --- API ---
# Solo para desarrollo local (pnpm api:dev). En Docker, compose arma su propia URL hacia el servicio "db".
DATABASE_URL=postgres://justipe:CAMBIAME@localhost:5432/justipe
PORT=3000
DB_POOL_MAX=5
# Aplica migraciones pendientes al arrancar la API (true/false)
MIGRATE_ON_START=true
TZ=America/Lima

# Interfaz y puerto donde se publica la API en el host.
# Caddy en el host -> 127.0.0.1 (por defecto). Nunca 0.0.0.0 en el VPS.
API_BIND=127.0.0.1
API_PORT=3000

# --- Auth ---
# Secreto para firmar el JWT (mínimo 32 caracteres). Ej: openssl rand -base64 48
JWT_SECRET=
# Hash scrypt de tu contraseña. Genéralo con: pnpm hash-password
APP_PASSWORD_HASH=
# Días de vigencia del token antes de volver a pedir la contraseña
JWT_TTL_DAYS=30

# --- Tareas programadas ---
# Generación diaria de recurrentes y consulta del tipo de cambio (true/false)
JOBS_ENABLED=true
# Consulta automática a apis.net.pe; si es false, el tipo de cambio solo se edita a mano
EXCHANGE_RATE_SYNC_ENABLED=true
# Endpoint v1 (funciona sin token, pero con un límite bajo de peticiones)
APIS_NET_PE_URL=https://api.apis.net.pe/v1/tipo-cambio-sunat
# Opcional: token de apis.net.pe para tener un límite más alto
APIS_NET_PE_TOKEN=

# --- Tests ---
# Opcional. Si no se define, se usa DATABASE_URL con el nombre terminado en "_test".
# La base de tests se BORRA en cada corrida: nunca apuntes a la de producción.
# TEST_DATABASE_URL=postgres://justipe:CAMBIAME@localhost:5432/justipe_test
